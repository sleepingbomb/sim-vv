<!--
  3-joint planar arm in the horizontal (x-y) plane, SCARA style. Every hinge axis is vertical,
  so gravity puts no torque on the joints and plain PD control reaches the target exactly.
  (Change an axis to "0 1 0" to watch REQ-002 fail from gravity sag.)

  Hand-written rather than downloaded so every number is right here. For a real arm from
  MuJoCo Menagerie see "Swapping in a real arm" in README.md.

  Units: m, kg, s, rad.
-->
<mujoco model="simple_arm">
  <!-- MuJoCo defaults to degrees; everything in this repo is radians -->
  <compiler angle="radian"/>

  <!-- 500 physics steps per simulated second -->
  <option timestep="0.002"/>

  <default>
    <!-- armature evens out the light wrist and the heavy shoulder under the same gains,
         damping keeps things from ringing -->
    <joint type="hinge" axis="0 0 1" range="-3.0 3.0" armature="0.1" damping="0.2"/>
    <geom type="capsule" size="0.03"/>
  </default>

  <worldbody>
    <body name="link1" pos="0 0 0">
      <joint name="shoulder"/>
      <geom name="link1_geom" fromto="0 0 0 0.30 0 0" mass="1.0"/>
      <body name="link2" pos="0.30 0 0">
        <joint name="elbow"/>
        <geom name="link2_geom" fromto="0 0 0 0.25 0 0" mass="0.6"/>
        <body name="link3" pos="0.25 0 0">
          <joint name="wrist"/>
          <geom name="link3_geom" fromto="0 0 0 0.15 0 0" mass="0.3"/>
          <site name="tip" pos="0.15 0 0"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- one torque motor per joint, same order as the joints; runner.py relies on that -->
  <actuator>
    <motor name="shoulder_motor" joint="shoulder" ctrlrange="-20 20"/>
    <motor name="elbow_motor"    joint="elbow"    ctrlrange="-20 20"/>
    <motor name="wrist_motor"    joint="wrist"    ctrlrange="-20 20"/>
  </actuator>
</mujoco>
